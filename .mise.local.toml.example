# Copy this file to .mise.local.toml (gitignored) and fill in real values.
# mise automatically loads .mise.local.toml on top of .mise.toml.

[env]
# Bitwarden Secrets Manager access token for a machine account scoped to the
# "home-ops" project (org ID 954ba461-2dcd-41b7-a73d-b30b0145a152, project ID
# b404372f-38ee-48f0-b66a-b30c00ab0414 — see
# kubernetes/apps/external-secrets/bitwarden/app/clustersecretstore.yaml).
# Create/rotate at: Bitwarden web vault -> Secrets Manager -> Machine accounts.
BWS_ACCESS_TOKEN = ""
